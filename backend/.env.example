PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/codesync
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret
EXECUTION_PROVIDER=local
# Optional only if you self-host or have access to a Piston instance:
# EXECUTION_PROVIDER=piston
# PISTON_URL=https://your-piston-host/api/v2/piston
